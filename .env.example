# Copier ce fichier en ".env" puis renseigner les valeurs du projet Firebase
# (console Firebase > Paramètres du projet > Vos applications > Configuration du SDK).
# Nécessaire uniquement pour l'onglet "Photo" (lecture des notes manuscrites par Gemini).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optionnel : modèle Gemini utilisé (par défaut gemini-2.5-flash).
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
